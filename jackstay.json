{
  "$schema": "./schemas/jackstay.schema.json",
  "jackstay_schema": 3,
  "project": "jackstay",
  "receipts": {
    "inputs": [
      "."
    ],
    "exclude": [
      ".claude/**",
      ".omc/**",
      ".omx/**",
      ".idea/**"
    ],
    "toolchain": [
      [
        "git",
        "--version"
      ],
      [
        "go",
        "version"
      ]
    ],
    "env": [
      "JACKSTAY_*",
      "GO*"
    ]
  },
  "test": {
    "judge": "steps",
    "timeout": 1800,
    "scopes": {
      "x-go": {
        "run": [
          "go",
          "test",
          "-race",
          "-tags",
          "integration",
          "-json",
          "-count=1",
          "./..."
        ],
        "when": "after any change to cmd/, internal/ or go.mod: every unit and integration test, once, with the race detector",
        "judge": "go-json",
        "ci": [
          "linux"
        ]
      },
      "x-check": {
        "run": [
          "just",
          "check"
        ],
        "when": "with x-go: gofmt, go vet, golangci-lint, shellcheck; no test (docs/design/implementation.md section 10)",
        "judge": "exit",
        "kind": "check",
        "ci": [
          "linux"
        ]
      },
      "x-sec": {
        "run": [
          "just",
          "security"
        ],
        "when": "before an install: govulncheck and gosec; no test",
        "judge": "exit",
        "kind": "check",
        "ci": [
          "linux"
        ]
      },
      "x-docs": {
        "run": [
          "just",
          "docs"
        ],
        "when": "after a change to documents: the site builds and its links lead somewhere; no Go test (x-go runs internal/docs)",
        "judge": "exit",
        "kind": "check",
        "ci": [
          "linux"
        ]
      },
      "gate": {
        "deps": [
          "x-check",
          "x-go",
          "x-sec",
          "x-docs"
        ],
        "when": "before a finished step is pushed (W-040): every scope; on a Mac it also tests the *_darwin.go code no CI job reaches. Before an install or a tag, `jst test uncovered` runs the same on a Mac and records the pass the install needs"
      }
    }
  },
  "ids": {
    "W": {
      "files": "docs/decisions/W-{n}-*.md",
      "width": 3
    }
  },
  "procs": {
    "default_minutes": 30,
    "max_minutes": 240
  },
  "review": {},
  "land": {
    "host": "github",
    "autonomy": "merge-when-green",
    "method": "squash",
    "checks": [],
    "human_paths": []
  },
  "adopt": {
    "pin": "v0.6.0"
  }
}
