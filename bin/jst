#!/bin/sh
# jackstay from its checkout: builds .build/jst from this tree and runs it. Projects use the
# installed copy (`bin/jst install`), not this file.
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
GOCACHE="${GOCACHE:-$HOME/.cache/go-build}" GOMODCACHE="${GOMODCACHE:-$HOME/go/pkg/mod}" \
  go -C "$root" build -trimpath -o .build/jst ./cmd/jst
exec "$root/.build/jst" "$@"
