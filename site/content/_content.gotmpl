{{- /*
  The site's pages, read from the repository (W-076: one source). The site carries what a user
  needs (W-077): the guide from docs/guide, the generated reference from docs/reference, and the
  contributors' pages; the design and the decision records stay in the repository, and links to
  them lead to GitHub (layouts/_markup/render-link.html).

  docs/guide/README.md orders everything: its `## ` headings are the sidebar's groups (each group's
  page shows the README's text under the heading), and a page comes where the README first links
  to it. The guide's files stay in one folder; `groups` puts each in its group. Everything is of
  type docs, so Hextra shows the sidebar beside every page at every desktop width and the previous
  and next pages below each.
*/ -}}
{{- $order := (resources.Get "docs/guide/README.md").Content -}}
{{- $at := dict -}}
{{- range slice "](../reference/README.md" "\n## Contributing\n" -}}
  {{- if not (strings.Contains $order .) }}{{ errorf "docs/guide/README.md has no %q" . }}{{ end -}}
  {{- $at = merge $at (dict . (add (len (index (split $order .) 0)) 1)) -}}
{{- end -}}
{{- $start := "start" -}}
{{- $daily := "daily-work" -}}
{{- $agents := "agents" -}}
{{- partial "jackstay/pages-from-docs.html" (dict
  "adapter" .
  "section" "guide"
  "folder" "docs/guide"
  "type" "docs"
  "groups" (dict
    "getting-started.md" $start "install.md" $start "adopt.md" $start
    "tests.md" $daily "guard.md" $daily "branches-and-github.md" $daily "review.md" $daily
    "background.md" $daily "records.md" $daily "releases.md" $daily "observability.md" $daily
    "maven-surefire.md" $daily "merge-queue.md" $daily "homebrew-tap.md" $daily
    "session-chat.md" $agents "context-brief.md" $agents "workspace-board.md" $agents
    "claude-code.md" $agents "codex.md" $agents
  )
  "headings" (dict $start "Start" $daily "Daily work" $agents "Working with several agents")
) -}}
{{- partial "jackstay/pages-from-docs.html" (dict
  "adapter" .
  "section" "guide/reference"
  "folder" "docs/reference"
  "type" "docs"
  "weight" (index $at "](../reference/README.md")
) -}}
{{- $contributing := index $at "\n## Contributing\n" -}}
{{- partial "jackstay/page-from-file.html" (dict "adapter" . "kind" "section" "path" "guide/contributing"
  "file" "CONTRIBUTING.md" "title" "Contributing" "weight" $contributing) -}}
{{- partial "jackstay/page-from-file.html" (dict "adapter" . "path" "guide/contributing/style"
  "file" "docs/STYLE.md" "weight" 1) -}}
