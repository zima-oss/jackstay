{{- /*
  The guide, read from docs/guide (W-076: one source). The site carries only what a user needs
  (W-077): the design and the decision records stay in the repository, and the guide's links to
  them lead to GitHub (layouts/_markup/render-link.html). The integrations are a group of their own
  in the sidebar, guide/integrations (its page is content/guide/integrations/_index.md). The guide
  is of type docs, so Hextra shows its sidebar beside every page at every desktop width (its default
  type hides the sidebar below 1280 pixels and lists nothing in it) and the previous and next pages
  below each.
*/ -}}
{{- partial "jackstay/pages-from-docs.html" (dict
  "adapter" .
  "section" "guide"
  "folder" "docs/guide"
  "groups" (dict "claude-code.md" "integrations" "codex.md" "integrations")
  "type" "docs"
) -}}
{{- partial "jackstay/pages-from-docs.html" (dict
  "adapter" .
  "section" "guide/reference"
  "folder" "docs/reference"
  "type" "docs"
) -}}
